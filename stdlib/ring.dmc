struct RingBuffer {
    handle: int,
    cap: int,
    head: int,
    tail: int,
    len: int
}

fn ring_new(cap: int) -> RingBuffer {
    var c: int = cap;
    if (c <= 0) { c = 16; }
    let h: int = mem_alloc(c * 8);
    let r: RingBuffer = RingBuffer {
        handle: h,
        cap: c,
        head: 0,
        tail: 0,
        len: 0
    };
    return r;
}

fn ring_push_back(rb: *RingBuffer, val: int) -> int {
    if (rb.len >= rb.cap) {
        return 0;
    }
    let h: int = rb.handle;
    let tail: int = rb.tail;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            arr[tail] = val;
        }
    }
    rb.tail = (rb.tail + 1) % rb.cap;
    rb.len = rb.len + 1;
    return 1;
}

fn ring_pop_front(rb: *RingBuffer) -> int {
    if (rb.len == 0) {
        return 0;
    }
    let h: int = rb.handle;
    let head: int = rb.head;
    var val: int = 0;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            val = arr[head];
        }
    }
    rb.head = (rb.head + 1) % rb.cap;
    rb.len = rb.len - 1;
    return val;
}

fn ring_push_front(rb: *RingBuffer, val: int) -> int {
    if (rb.len >= rb.cap) {
        return 0;
    }
    let new_head: int = (rb.head - 1 + rb.cap) % rb.cap;
    let h: int = rb.handle;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            arr[new_head] = val;
        }
    }
    rb.head = new_head;
    rb.len = rb.len + 1;
    return 1;
}

fn ring_pop_back(rb: *RingBuffer) -> int {
    if (rb.len == 0) {
        return 0;
    }
    let new_tail: int = (rb.tail - 1 + rb.cap) % rb.cap;
    let h: int = rb.handle;
    var val: int = 0;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            val = arr[new_tail];
        }
    }
    rb.tail = new_tail;
    rb.len = rb.len - 1;
    return val;
}

fn ring_peek_front(rb: *RingBuffer) -> int {
    if (rb.len == 0) {
        return 0;
    }
    let h: int = rb.handle;
    let head: int = rb.head;
    var val: int = 0;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            val = arr[head];
        }
    }
    return val;
}

fn ring_peek_back(rb: *RingBuffer) -> int {
    if (rb.len == 0) {
        return 0;
    }
    let idx: int = (rb.tail - 1 + rb.cap) % rb.cap;
    let h: int = rb.handle;
    var val: int = 0;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            val = arr[idx];
        }
    }
    return val;
}

fn ring_get(rb: *RingBuffer, index: int) -> int {
    if (index < 0 || index >= rb.len) {
        return 0;
    }
    let actual_idx: int = (rb.head + index) % rb.cap;
    let h: int = rb.handle;
    var val: int = 0;
    c_code {
        if (h >= 0 && h < _dmc_mem_cap && _dmc_mem[h]) {
            long long *arr = (long long*)_dmc_mem[h];
            val = arr[actual_idx];
        }
    }
    return val;
}

fn ring_len(rb: *RingBuffer) -> int {
    return rb.len;
}

fn ring_cap(rb: *RingBuffer) -> int {
    return rb.cap;
}

fn ring_is_empty(rb: *RingBuffer) -> int {
    if (rb.len == 0) {
        return 1;
    }
    return 0;
}

fn ring_is_full(rb: *RingBuffer) -> int {
    if (rb.len >= rb.cap) {
        return 1;
    }
    return 0;
}

fn ring_clear(rb: *RingBuffer) {
    rb.head = 0;
    rb.tail = 0;
    rb.len = 0;
}

fn ring_free(rb: *RingBuffer) {
    if (rb.handle > 0) {
        mem_free(rb.handle);
        rb.handle = 0;
        rb.cap = 0;
        rb.head = 0;
        rb.tail = 0;
        rb.len = 0;
    }
}