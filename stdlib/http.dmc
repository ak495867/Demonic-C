// Demonic C Standard Library: http
// High-performance HTTP client & multi-threaded server engine

import thread;

fn http_get_text(url: string) -> string {
    return http_get(url);
}

fn http_get_status(url: string) -> int {
    return http_status(url);
}

fn http_status_text(code: int) -> string {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 500) { return "Internal Server Error"; }
    return "OK";
}

fn http_response(status: int, content_type: string, body: string) -> string {
    let status_line = "HTTP/1.1 " + text_from_int(status) + " " + http_status_text(status) + "\r\n";
    let headers = "Content-Type: " + content_type + "\r\nContent-Length: " + text_from_int(text_len(body)) + "\r\nConnection: close\r\n\r\n";
    return status_line + headers + body;
}

fn http_response_json(status: int, json_body: string) -> string {
    return http_response(status, "application/json", json_body);
}

fn http_response_html(status: int, html_body: string) -> string {
    return http_response(status, "text/html", html_body);
}

fn http_req_method(req: string) -> string {
    if (text_cmp(text_sub(req, 0, 4), "POST") == 0) { return "POST"; }
    if (text_cmp(text_sub(req, 0, 3), "PUT") == 0) { return "PUT"; }
    if (text_cmp(text_sub(req, 0, 6), "DELETE") == 0) { return "DELETE"; }
    return "GET";
}

fn http_req_path(req: string) -> string {
    let len = text_len(req);
    var start = -1;
    var end = -1;
    for (var i = 0; i < len; i = i + 1) {
        let ch = text_char_at(req, i);
        if (ch == 32) {
            if (start == -1) {
                start = i + 1;
            } else if (end == -1) {
                end = i;
                break;
            }
        }
    }
    if (start != -1 && end != -1 && end > start) {
        return text_sub(req, start, end - start);
    }
    return "/";
}

fn http_server_bind(port: int) -> int {
    return tcp_listen(port, 128);
}

fn http_server_close_sock(s: int) -> int {
    return tcp_close(s);
}
