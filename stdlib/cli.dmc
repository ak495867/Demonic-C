struct CliApp {
    name: string,
    description: string,
    version: string,
    raw_args: string,
    count: int
}

fn _cli_sep() -> string {
    var out: string = "";
    c_code {
        static char sep[2] = { 31, 0 };
        out = sep;
    }
    return out;
}

fn _cli_get_arg(raw: string, target_idx: int) -> string {
    let len: int = text_len(raw);
    if (len == 0 || target_idx < 0) {
        return "";
    }
    var cur_idx: int = 0;
    var i: int = 0;
    while (i < len) {
        if (text_char_at(raw, i) == 31) {
            i = i + 1;
        }
        var next_sep: int = len;
        var j: int = i;
        while (j < len) {
            if (text_char_at(raw, j) == 31) {
                next_sep = j;
                break;
            }
            j = j + 1;
        }
        if (cur_idx == target_idx) {
            return string_slice(raw, i, next_sep - i);
        }
        cur_idx = cur_idx + 1;
        i = next_sep + 1;
    }
    return "";
}

fn cli_count() -> int {
    return arg_count();
}

fn cli_arg(idx: int) -> string {
    return arg_text(idx);
}

fn cli_has_flag(flag: string) -> int {
    let count: int = arg_count();
    var i: int = 1;
    while (i < count) {
        if (arg_text(i) == flag) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn cli_get_opt(opt: string, default_val: string) -> string {
    let count: int = arg_count();
    let prefix: string = opt + "=";
    let plen: int = text_len(prefix);
    var i: int = 1;
    while (i < count) {
        let a: string = arg_text(i);
        if (a == opt && (i + 1) < count) {
            return arg_text(i + 1);
        }
        if (text_len(a) > plen && string_slice(a, 0, plen) == prefix) {
            return string_slice(a, plen, text_len(a) - plen);
        }
        i = i + 1;
    }
    return default_val;
}

fn cli_get_int_opt(opt: string, default_val: int) -> int {
    let val: string = cli_get_opt(opt, "");
    if (text_len(val) == 0) {
        return default_val;
    }
    return text_to_int(val);
}

fn cli_new(name: string, desc: string, ver: string) -> CliApp {
    let app: CliApp = CliApp {
        name: name,
        description: desc,
        version: ver,
        raw_args: "",
        count: 0
    };
    return app;
}

fn cli_from_sys(name: string, desc: string, ver: string) -> CliApp {
    var app: CliApp = cli_new(name, desc, ver);
    let total: int = arg_count();
    var i: int = 1;
    while (i < total) {
        cli_add_arg(&app, arg_text(i));
        i = i + 1;
    }
    return app;
}

fn cli_add_arg(app: *CliApp, arg: string) {
    let sep: string = _cli_sep();
    app.raw_args = app.raw_args + sep + arg;
    app.count = app.count + 1;
}

fn cli_has(app: *CliApp, flag: string) -> int {
    let n: int = app.count;
    var i: int = 0;
    while (i < n) {
        if (_cli_get_arg(app.raw_args, i) == flag) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn cli_get(app: *CliApp, opt: string, default_val: string) -> string {
    let n: int = app.count;
    let prefix: string = opt + "=";
    let plen: int = text_len(prefix);
    var i: int = 0;
    while (i < n) {
        let a: string = _cli_get_arg(app.raw_args, i);
        if (a == opt && (i + 1) < n) {
            return _cli_get_arg(app.raw_args, i + 1);
        }
        if (text_len(a) > plen && string_slice(a, 0, plen) == prefix) {
            return string_slice(a, plen, text_len(a) - plen);
        }
        i = i + 1;
    }
    return default_val;
}

fn cli_get_int(app: *CliApp, opt: string, default_val: int) -> int {
    let val: string = cli_get(app, opt, "");
    if (text_len(val) == 0) {
        return default_val;
    }
    return text_to_int(val);
}

fn cli_get_subcommand(app: *CliApp) -> string {
    let n: int = app.count;
    var i: int = 0;
    while (i < n) {
        let a: string = _cli_get_arg(app.raw_args, i);
        if (text_len(a) > 0 && text_char_at(a, 0) != 45) {
            return a;
        }
        i = i + 1;
    }
    return "";
}

fn cli_help(app: *CliApp, usage: string) -> string {
    var out: string = app.name + " v" + app.version + "\n";
    if (text_len(app.description) > 0) {
        out = out + app.description + "\n\n";
    }
    out = out + "Usage: " + usage + "\n";
    return out;
}

fn cli_free(app: *CliApp) {
    app.raw_args = "";
    app.count = 0;
}