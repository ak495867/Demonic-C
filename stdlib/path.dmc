fn path_is_sep(c: int) -> int {
    if (c == 47 || c == 92) { return 1; }
    return 0;
}

fn path_join(dir: string, file: string) -> string {
    let dlen = text_len(dir);
    if (dlen == 0) { return file; }
    let flen = text_len(file);
    if (flen == 0) { return dir; }
    let last = text_char_at(dir, dlen - 1);
    if (path_is_sep(last)) {
        return text_concat(dir, file);
    }
    return text_concat(text_concat(dir, "/"), file);
}

fn path_basename(p: string) -> string {
    let len = text_len(p);
    if (len == 0) { return ""; }
    var i: int = len - 1;
    while (i >= 0) {
        let c = text_char_at(p, i);
        if (path_is_sep(c)) {
            return string_slice(p, i + 1, len - (i + 1));
        }
        i = i - 1;
    }
    return p;
}

fn path_dirname(p: string) -> string {
    let len = text_len(p);
    if (len == 0) { return "."; }
    var i: int = len - 1;
    while (i >= 0) {
        let c = text_char_at(p, i);
        if (path_is_sep(c)) {
            if (i == 0) { return "/"; }
            return string_slice(p, 0, i);
        }
        i = i - 1;
    }
    return ".";
}

fn path_extension(p: string) -> string {
    let len = text_len(p);
    if (len == 0) { return ""; }
    var i: int = len - 1;
    while (i >= 0) {
        let c = text_char_at(p, i);
        if (path_is_sep(c)) { break; }
        if (c == 46) {
            return string_slice(p, i, len - i);
        }
        i = i - 1;
    }
    return "";
}

fn path_has_extension(p: string, ext: string) -> int {
    let cur = path_extension(p);
    if (text_cmp(cur, ext) == 0) { return 1; }
    return 0;
}
