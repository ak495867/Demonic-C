// Demonic C Standard Library - High-Level File System Module

fn fs_read_to_string(path: string) -> string {
    return fs_read(path);
}

fn fs_write_string(path: string, content: string) -> int {
    return fs_write(path, content);
}

fn fs_append_string(path: string, content: string) -> int {
    return fs_append(path, content);
}

fn fs_file_exists(path: string) -> int {
    return fs_exists(path);
}

fn fs_remove_file(path: string) -> int {
    return fs_remove(path);
}

fn fs_file_size(path: string) -> int {
    return fs_size(path);
}
