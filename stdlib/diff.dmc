fn diff_levenshtein(s1: string, s2: string) -> int {
    var dist: int = 0;
    c_code {
        int m = (int)strlen(s1);
        int n = (int)strlen(s2);
        if (m == 0) {
            dist = n;
        } else if (n == 0) {
            dist = m;
        } else {
            int *dp = (int*)malloc((size_t)(n + 1) * sizeof(int));
            if (dp) {
                for (int j = 0; j <= n; j = j + 1) {
                    dp[j] = j;
                }
                for (int i = 1; i <= m; i = i + 1) {
                    int prev = dp[0];
                    dp[0] = i;
                    for (int j = 1; j <= n; j = j + 1) {
                        int temp = dp[j];
                        int cost = (s1[i - 1] == s2[j - 1]) ? 0 : 1;
                        int m1 = dp[j] + 1;
                        int m2 = dp[j - 1] + 1;
                        int m3 = prev + cost;
                        int min_val = m1 < m2 ? m1 : m2;
                        if (m3 < min_val) min_val = m3;
                        dp[j] = min_val;
                        prev = temp;
                    }
                }
                dist = dp[n];
                free(dp);
            }
        }
    }
    return dist;
}

fn diff_similarity(s1: string, s2: string) -> float {
    let l1: int = text_len(s1);
    let l2: int = text_len(s2);
    if (l1 == 0 && l2 == 0) {
        return 1.0;
    }
    var max_len: int = l1;
    if (l2 > max_len) {
        max_len = l2;
    }
    let d: int = diff_levenshtein(s1, s2);
    var fd: float = d * 1.0;
    var fmax: float = max_len * 1.0;
    let sim: float = 1.0 - (fd / fmax);
    return sim;
}

fn diff_hamming(s1: string, s2: string) -> int {
    let l1: int = text_len(s1);
    let l2: int = text_len(s2);
    if (l1 != l2) {
        return -1;
    }
    var diff_count: int = 0;
    var i: int = 0;
    while (i < l1) {
        if (text_char_at(s1, i) != text_char_at(s2, i)) {
            diff_count = diff_count + 1;
        }
        i = i + 1;
    }
    return diff_count;
}

fn diff_lcs(s1: string, s2: string) -> string {
    var out: string = "";
    c_code {
        int m = (int)strlen(s1);
        int n = (int)strlen(s2);
        if (m > 0 && n > 0) {
            int stride = n + 1;
            int *dp = (int*)calloc((size_t)((m + 1) * stride), sizeof(int));
            if (dp) {
                for (int i = 1; i <= m; i = i + 1) {
                    for (int j = 1; j <= n; j = j + 1) {
                        if (s1[i - 1] == s2[j - 1]) {
                            dp[i * stride + j] = dp[(i - 1) * stride + (j - 1)] + 1;
                        } else {
                            int v1 = dp[(i - 1) * stride + j];
                            int v2 = dp[i * stride + (j - 1)];
                            dp[i * stride + j] = v1 > v2 ? v1 : v2;
                        }
                    }
                }
                int lcs_len = dp[m * stride + n];
                char *res = (char*)malloc(lcs_len + 1);
                if (res) {
                    res[lcs_len] = 0;
                    int i = m;
                    int j = n;
                    int idx = lcs_len - 1;
                    while (i > 0 && j > 0) {
                        if (s1[i - 1] == s2[j - 1]) {
                            res[idx] = s1[i - 1];
                            idx = idx - 1;
                            i = i - 1;
                            j = j - 1;
                        } else if (dp[(i - 1) * stride + j] > dp[i * stride + (j - 1)]) {
                            i = i - 1;
                        } else {
                            j = j - 1;
                        }
                    }
                    out = res;
                }
                free(dp);
            }
        }
    }
    return out;
}

fn diff_closest(target: string, candidates: Vector<string>) -> string {
    let n: int = candidates.len();
    if (n == 0) {
        return "";
    }
    var best_str: string = candidates.get(0);
    var best_dist: int = diff_levenshtein(target, best_str);
    var i: int = 1;
    while (i < n) {
        let cur: string = candidates.get(i);
        let d: int = diff_levenshtein(target, cur);
        if (d < best_dist) {
            best_dist = d;
            best_str = cur;
        }
        i = i + 1;
    }
    return best_str;
}