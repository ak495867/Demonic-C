struct VcdSignal {
    name: string,
    ident: string,
    width: int,
    value: int
}

struct VcdWriter {
    timescale: string,
    module_name: string,
    signal_count: int,
    current_time: int
}

fn vcd_new(timescale: string, mod_name: string) -> VcdWriter {
    let w: VcdWriter = VcdWriter {
        timescale: timescale,
        module_name: mod_name,
        signal_count: 0,
        current_time: 0
    };
    return w;
}

fn vcd_to_binary_str(val: int, width: int) -> string {
    if (width <= 1) {
        if (val & 1) {
            return "1";
        }
        return "0";
    }
    var res: string = "";
    var i: int = width - 1;
    while (i >= 0) {
        var bit: int = (val >> i) & 1;
        if (bit == 1) {
            res = res + "1";
        } else {
            res = res + "0";
        }
        i = i - 1;
    }
    return res;
}

fn vcd_format_header(w: *VcdWriter, sig0: string, id0: string, w0: int, sig1: string, id1: string, w1: int) -> string {
    var out: string = "$date 2026-11-18 $end\n";
    out = out + "$version Demonic C 2.0.9 Silicon Synthesizer $end\n";
    out = out + "$timescale " + w.timescale + " $end\n";
    out = out + "$scope module " + w.module_name + " $end\n";
    out = out + "$var wire " + text_from_int(w0) + " " + id0 + " " + sig0 + " $end\n";
    out = out + "$var wire " + text_from_int(w1) + " " + id1 + " " + sig1 + " $end\n";
    out = out + "$upscope $end\n";
    out = out + "$enddefinitions $end\n";
    out = out + "$dumpvars\n";
    out = out + "b" + vcd_to_binary_str(0, w0) + " " + id0 + "\n";
    out = out + "b" + vcd_to_binary_str(0, w1) + " " + id1 + "\n";
    out = out + "$end\n";
    return out;
}

fn vcd_format_change(timestamp: int, id: string, val: int, width: int) -> string {
    var out: string = "#" + text_from_int(timestamp) + "\n";
    if (width <= 1) {
        out = out + vcd_to_binary_str(val, 1) + id + "\n";
    } else {
        out = out + "b" + vcd_to_binary_str(val, width) + " " + id + "\n";
    }
    return out;
}

fn sim_assert_cycle(actual: int, expected: int, cycle: int) -> int {
    if (actual != expected) {
        return 0;
    }
    return 1;
}
