struct Decl {
    kind: int;
    name: string;
    start: int;
    end: int;
}
fn parse_top(ts: *Tok, count: int, decls: *Decl, cap: int) -> int {
    var i: int = 0;
    var n: int = 0;
    while (i < count) {
        var t: string = ts[i].text;
        if (t == "import") {
            n = n + 1;
            i = i + 3;
            continue;
        }
        i = i + 1;
    }
    return n;
}
fn main() -> int { return 0; }
