import "coro";

async fn async_multiply(x: int) -> int {
    var intermediate: int = x * 3;
    var res: int = await (intermediate + 2);
    return res;
}

#[test]
fn test_async_execution() -> int {
    var val: int = async_multiply(10);
    if (val != 32) {
        return 1;
    }
    return 0;
}

#[test]
fn test_coroutine_state_machine() -> int {
    var c: CoroHandle = coro_create(7);
    if (coro_is_done(&c) != 0) {
        return 1;
    }

    var sched: CoroScheduler = sched_new();
    var poll1: int = sched_poll(&sched, &c);
    if (poll1 != 0) {
        return 2;
    }
    if (coro_result(&c) != 70) {
        return 3;
    }

    var poll2: int = sched_poll(&sched, &c);
    if (poll2 != 1) {
        return 4;
    }
    if (coro_is_done(&c) != 1) {
        return 5;
    }
    if (coro_result(&c) != 75) {
        return 6;
    }

    return 0;
}

#[test]
fn test_channel_select() -> int {
    if (channel_select_2(4, 0) != 0) {
        return 1;
    }
    if (channel_select_2(0, 2) != 1) {
        return 2;
    }
    if (channel_select_2(0, 0) != -1) {
        return 3;
    }
    if (channel_select_3(0, 0, 9) != 2) {
        return 4;
    }
    return 0;
}
