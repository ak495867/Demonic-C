import "low";

fn main() -> int {
    let a: int = arena_new(64);
    if (a < 0) { return 100; }
    let o1: int = arena_alloc(a, 4);
    let o2: int = arena_alloc(a, 4);
    if (o1 != 0) { return 101; }
    if (o2 != 4) { return 102; }
    arena_write(a, o1, 0, 7);
    arena_write(a, o2, 1, 9);
    let r1: int = arena_read(a, o1, 0);
    let r2: int = arena_read(a, o2, 1);
    if (r1 != 7) { return 103; }
    if (r2 != 9) { return 104; }
    if (arena_top(a) != 8) { return 105; }
    arena_reset(a);
    if (arena_top(a) != 0) { return 106; }
    let o3: int = arena_alloc(a, 4);
    if (o3 != 0) { return 107; }
    if (arena_alloc(a, 1000) != -1) { return 108; }
    if (port_valid() != 0) { return 109; }
    if (port_in8(96) != -1) { return 110; }
    if (port_out8(97, 1) != -1) { return 111; }
    isr_set(32, 77);
    if (isr_get(32) != 77) { return 112; }
    if (isr_call(32, 0) != 77) { return 113; }
    isr_set(32, -1);
    if (isr_get(32) != -1) { return 114; }
    arena_free(a);
    return 0;
}
