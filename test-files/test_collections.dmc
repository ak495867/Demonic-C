fn main() -> int {
    let v = vec_new();
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    let vs = vec_get(v, 0) + vec_get(v, 1) + vec_get(v, 2);

    let q = queue_new();
    queue_push(q, 5);
    queue_push(q, 7);
    let qs = queue_pop(q) + queue_pop(q);

    let m = map_new();
    map_set(m, 1, 100);
    map_set(m, 2, 200);
    let ms = map_get(m, 1) + map_get(m, 2);

    vec_free(v);
    queue_free(q);
    map_free(m);
    return vs + qs + ms;
}