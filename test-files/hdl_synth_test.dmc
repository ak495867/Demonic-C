import "hdl";

module Counter8(clk: u1, rst: u1, en: u1, out: *u8) {
    reg count: u8 = 0;

    sync(clk, rst) {
        if (rst) {
            count <= 0;
        } else if (en) {
            count <= count + 1;
        }
    }

    comb {
        *out = count;
    }
}

#[test]
fn test_hdl_slice() -> int {
    let v: u64 = 0xDEADBEEF12345678;
    let s1: u64 = hdl_slice(v, 7, 0);
    if (s1 != 0x78) {
        return 1;
    }
    let s2: u64 = hdl_slice(v, 15, 8);
    if (s2 != 0x56) {
        return 2;
    }
    let s3: u64 = hdl_slice(v, 31, 16);
    if (s3 != 0x1234) {
        return 3;
    }
    let s4: u64 = hdl_slice(v, 63, 0);
    if (s4 != v) {
        return 4;
    }
    return 0;
}

#[test]
fn test_hdl_concat() -> int {
    let a: u64 = 0xAA;
    let b: u64 = 0x55;
    let c: u64 = hdl_concat(a, 8, b, 8);
    if (c != 0xAA55) {
        return 1;
    }
    let hi: u64 = 0x1234;
    let lo: u64 = 0x5678;
    let word: u64 = hdl_concat(hi, 16, lo, 16);
    if (word != 0x12345678) {
        return 2;
    }
    return 0;
}

#[test]
fn test_hdl_bit_and_set() -> int {
    let v: u64 = 0x01;
    if (hdl_bit(v, 0) != 1) {
        return 1;
    }
    if (hdl_bit(v, 1) != 0) {
        return 2;
    }
    let set3: u64 = hdl_set_bit(0, 3, 1);
    if (set3 != 8) {
        return 3;
    }
    let clr3: u64 = hdl_set_bit(set3, 3, 0);
    if (clr3 != 0) {
        return 4;
    }
    return 0;
}

#[test]
fn test_counter8_reset() -> int {
    var c: Counter8 = Counter8_new();
    var out: u8 = 99;
    Counter8_tick(&c, 1, 1, 0, &out);
    if (out != 0) {
        return 1;
    }
    if (c.count != 0) {
        return 2;
    }
    return 0;
}

#[test]
fn test_counter8_count_sequence() -> int {
    var c: Counter8 = Counter8_new();
    var out: u8 = 0;

    Counter8_tick(&c, 1, 1, 0, &out);
    if (out != 0) {
        return 1;
    }

    Counter8_tick(&c, 1, 0, 1, &out);
    if (out != 1) {
        return 2;
    }

    Counter8_tick(&c, 1, 0, 1, &out);
    if (out != 2) {
        return 3;
    }

    Counter8_tick(&c, 1, 0, 0, &out);
    if (out != 2) {
        return 4;
    }

    Counter8_tick(&c, 1, 0, 1, &out);
    if (out != 3) {
        return 5;
    }

    Counter8_tick(&c, 1, 1, 0, &out);
    if (out != 0) {
        return 6;
    }

    return 0;
}
