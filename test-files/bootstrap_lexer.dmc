import "mem";

struct Tok {
    kind: int;
    text: string;
    line: int;
}

fn is_digit(c: int) -> int {
    return c >= 48 && c <= 57;
}

fn is_alpha(c: int) -> int {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn is_alnum(c: int) -> int {
    return is_digit(c) || is_alpha(c);
}

fn punc_kind(text: string) -> int {
    if (text_cmp(text, "{") == 0) {
        return 60;
    }
    if (text_cmp(text, "}") == 0) {
        return 61;
    }
    if (text_cmp(text, "(") == 0) {
        return 62;
    }
    if (text_cmp(text, ")") == 0) {
        return 63;
    }
    if (text_cmp(text, "[") == 0) {
        return 64;
    }
    if (text_cmp(text, "]") == 0) {
        return 65;
    }
    if (text_cmp(text, ";") == 0) {
        return 66;
    }
    if (text_cmp(text, ",") == 0) {
        return 67;
    }
    if (text_cmp(text, "=") == 0) {
        return 68;
    }
    if (text_cmp(text, "==") == 0) {
        return 69;
    }
    if (text_cmp(text, "!=") == 0) {
        return 70;
    }
    if (text_cmp(text, "<") == 0) {
        return 71;
    }
    if (text_cmp(text, "<=") == 0) {
        return 72;
    }
    if (text_cmp(text, ">") == 0) {
        return 73;
    }
    if (text_cmp(text, ">=") == 0) {
        return 74;
    }
    if (text_cmp(text, "+") == 0) {
        return 75;
    }
    if (text_cmp(text, "-") == 0) {
        return 76;
    }
    if (text_cmp(text, "*") == 0) {
        return 77;
    }
    if (text_cmp(text, "/") == 0) {
        return 78;
    }
    if (text_cmp(text, "%") == 0) {
        return 79;
    }
    if (text_cmp(text, "!") == 0) {
        return 80;
    }
    if (text_cmp(text, "&&") == 0) {
        return 81;
    }
    if (text_cmp(text, "||") == 0) {
        return 82;
    }
    if (text_cmp(text, "&") == 0) {
        return 83;
    }
    if (text_cmp(text, ":") == 0) {
        return 84;
    }
    if (text_cmp(text, "::") == 0) {
        return 85;
    }
    if (text_cmp(text, "->") == 0) {
        return 86;
    }
    if (text_cmp(text, ".") == 0) {
        return 87;
    }
    return 88;
}

fn push(out: *Tok, count: int, cap: int, kind: int, text: string, line: int) -> int {
    if (count >= cap) {
        return count;
    }
    out[count] = Tok{kind: kind, text: text, line: line};
    return count + 1;
}

fn lex(input: string, out: *Tok, cap: int) -> int {
    var len: int = text_len(input);
    var i: int = 0;
    var count: int = 0;
    var line: int = 1;
    while (i < len) {
        var c: int = text_char_at(input, i);
        if (c == 10) {
            line = line + 1;
            i = i + 1;
            continue;
        }
        if (c == 32 || c == 9 || c == 13) {
            i = i + 1;
            continue;
        }
        if (c == 47 && i + 1 < len && text_char_at(input, i + 1) == 47) {
            while (i < len && text_char_at(input, i) != 10) {
                i = i + 1;
            }
            continue;
        }
        var start: int = i;
        if (is_alpha(c)) {
            while (i < len && is_alnum(text_char_at(input, i))) {
                i = i + 1;
            }
            count = push(out, count, cap, 1, string_slice(input, start, i - start), line);
            continue;
        }
        if (is_digit(c)) {
            while (i < len && is_digit(text_char_at(input, i))) {
                i = i + 1;
            }
            count = push(out, count, cap, 2, string_slice(input, start, i - start), line);
            continue;
        }
        if (c == 34) {
            i = i + 1;
            var text_start: int = i;
            while (i < len && text_char_at(input, i) != 34) {
                if (text_char_at(input, i) == 92 && i + 1 < len) {
                    i = i + 1;
                }
                i = i + 1;
            }
            var tok_text: string = string_slice(input, text_start, i - text_start);
            if (i < len) {
                i = i + 1;
            }
            count = push(out, count, cap, 3, tok_text, line);
            continue;
        }
        if (i + 1 < len) {
            var pair: string = string_slice(input, i, 2);
            if (text_cmp(pair, "==") == 0 || text_cmp(pair, "!=") == 0 || text_cmp(pair, "<=") == 0 ||
                text_cmp(pair, ">=") == 0 || text_cmp(pair, "&&") == 0 || text_cmp(pair, "||") == 0 ||
                text_cmp(pair, "::") == 0 || text_cmp(pair, "->") == 0) {
                count = push(out, count, cap, 4, pair, line);
                i = i + 2;
                continue;
            }
        }
        var single: string = string_slice(input, i, 1);
        count = push(out, count, cap, 4, single, line);
        i = i + 1;
    }
    count = push(out, count, cap, 0, "", line);
    return count;
}

fn main() -> int {
    let src = "let x = 42;";
    var ts: [Tok; 64] = [
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
        Tok{kind: 0, text: "", line: 0}, Tok{kind: 0, text: "", line: 0},
    ];
    let count = lex(src, &ts[0], 64);
    var k: int = 0;
    while (k < count) {
        println(ts[k].kind);
        println(ts[k].text);
        println(ts[k].line);
        k = k + 1;
    }
    return count;
}
