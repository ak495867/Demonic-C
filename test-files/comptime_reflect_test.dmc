static_assert(1 + 1 == 2, "one plus one equals two");

comptime let BUFFER_CAPACITY: int = 64;

#[reflect]
struct SensorPacket {
    id: int,
    reading: int,
    status: string
}

#[test]
fn test_comptime_constant() -> int {
    if (BUFFER_CAPACITY != 64) {
        return 1;
    }
    return 0;
}

#[test]
fn test_struct_reflection() -> int {
    var count: int = SensorPacket_field_count();
    if (count != 3) {
        return 1;
    }

    var f0: string = SensorPacket_field_name(0);
    if (f0 != "id") {
        return 2;
    }

    var f1: string = SensorPacket_field_name(1);
    if (f1 != "reading") {
        return 3;
    }

    var f2: string = SensorPacket_field_name(2);
    if (f2 != "status") {
        return 4;
    }

    var t0: string = SensorPacket_field_type(0);
    if (t0 != "int") {
        return 5;
    }

    var t2: string = SensorPacket_field_type(2);
    if (t2 != "string") {
        return 6;
    }

    var off0: int = SensorPacket_field_offset(0);
    if (off0 != 0) {
        return 7;
    }

    return 0;
}
