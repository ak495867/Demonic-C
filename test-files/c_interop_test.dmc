// Demonic C -> C Family Interoperability Test Suite

#link "m"

extern fn puts(s: string) -> int;
extern fn sqrt(x: f64) -> f64;
extern fn abs(x: int) -> int;

extern "C" fn cos(x: f64) -> f64;

extern "C" {
    fn sin(x: f64) -> f64;
    fn tan(x: f64) -> f64;
    fn pow(base: f64, exp: f64) -> f64;
}

c_code {
    static int custom_c_multiplier(int a, int b) {
        return a * b;
    }

    static int custom_c_sum_three(int x, int y, int z) {
        return x + y + z;
    }
}

extern fn custom_c_multiplier(a: int, b: int) -> int;
extern fn custom_c_sum_three(x: int, y: int, z: int) -> int;

#[test]
fn test_c_math_functions() -> int {
    let s = sqrt(64.0);
    if (s != 8.0) { return 1; }

    let p = pow(2.0, 8.0);
    if (p != 256.0) { return 2; }

    let a = abs(-100);
    if (a != 100) { return 3; }

    let c = cos(0.0);
    if (c != 1.0) { return 4; }

    let si = sin(0.0);
    if (si != 0.0) { return 5; }

    return 0;
}

#[test]
fn test_top_level_c_code() -> int {
    let mult = custom_c_multiplier(7, 6);
    if (mult != 42) { return 1; }

    let sum = custom_c_sum_three(10, 20, 12);
    if (sum != 42) { return 2; }

    return 0;
}

#[test]
fn test_inline_statement_c_code() -> int {
    let flag = 0;
    c_code {
        flag = 42;
    }
    if (flag != 42) { return 1; }

    return 0;
}
