struct Point {
    x: int;
    y: int;
}

fn Point_length(p: Point) -> int {
    return p.x * p.x + p.y * p.y;
}

#[test]
fn test_method_syntax() -> int {
    // 1. String methods
    let s: string = "Demonic C";
    if (s.len() != 9) { return 1; }
    let sub = s.slice(0, 7);
    if (text_cmp(sub, "Demonic") != 0) { return 2; }

    // 2. Struct methods
    let pt = Point { x: 3, y: 4 };
    let len_sq = pt.length();
    if (len_sq != 25) { return 3; }

    // 3. Dynamic Vector methods
    let v = vec_new();
    v.push(100);
    v.push(200);
    if (v.len() != 2) { return 4; }
    if (v.get(0) != 100) { return 5; }
    if (v.get(1) != 200) { return 6; }
    v.free();

    // 4. Hash map methods
    let m = map_new();
    m.set(42, 9999);
    if (m.has(42) != 1) { return 7; }
    if (m.get(42) != 9999) { return 8; }
    m.free();

    return 0;
}

#[test]
fn test_stdlib_fs_os_crypto() -> int {
    // 1. FS
    let path: string = "test_supercharge.tmp";
    if (fs_write(path, "Demonic Systems!") != 0) { return 11; }
    if (fs_exists(path) != 1) { return 12; }
    let read_back = fs_read(path);
    if (text_cmp(read_back, "Demonic Systems!") != 0) { return 13; }
    if (fs_size(path) != 16) { return 14; }
    if (fs_remove(path) != 0) { return 15; }
    if (fs_exists(path) != 0) { return 16; }

    // 2. OS
    let plat = os_platform();
    if (text_len(plat) == 0) { return 21; }
    let arch = os_arch();
    if (text_len(arch) == 0) { return 22; }

    // 3. Crypto & Base64
    let b64 = base64_encode("Hello DMC");
    if (text_cmp(b64, "SGVsbG8gRE1D") != 0) { return 31; }
    let orig = base64_decode(b64);
    if (text_cmp(orig, "Hello DMC") != 0) { return 32; }

    let hash = sha256("hello");
    // SHA256 of "hello" is 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
    if (text_cmp(hash, "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824") != 0) { return 33; }

    return 0;
}
