var drops_called: int = 0;

struct ManagedBuffer {
    handle: int
}

fn ManagedBuffer_drop(buf: *ManagedBuffer) -> void {
    drops_called = drops_called + 1;
}

fn create_and_drop_scope() -> void {
    let b1: ManagedBuffer = ManagedBuffer { handle: 101 };
}

fn create_and_early_return(cond: int) -> int {
    let b2: ManagedBuffer = ManagedBuffer { handle: 202 };
    if (cond == 1) {
        return 42;
    }
    return 10;
}

#[test]
fn test_raii_drop_scope() -> int {
    drops_called = 0;
    create_and_drop_scope();
    if (drops_called != 1) {
        return 1;
    }
    return 0;
}

#[test]
fn test_raii_drop_early_return() -> int {
    drops_called = 0;
    let ret: int = create_and_early_return(1);
    if (ret != 42) {
        return 1;
    }
    if (drops_called != 1) {
        return 2;
    }
    return 0;
}
