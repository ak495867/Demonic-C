enum Result {
    Ok(string),
    Err(int)
}

#[test]
fn test_string_slice() -> int {
    let s: string = "Hello Demonic C World!";
    let part = s[0..5];
    if (text_cmp(part, "Hello") == 0) {
        return 0;
    }
    return 1;
}

#[test]
fn test_tagged_union() -> int {
    let res = Result_Ok("success");
    if (res.tag == Result_Ok) {
        if (text_cmp(res.data.Ok, "success") == 0) {
            return 0;
        }
    }
    return 1;
}
