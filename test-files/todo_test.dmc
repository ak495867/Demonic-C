#[test]
fn test_math() -> int {
    let a: int = math_abs(-42);
    if (a != 42) {
        return 1;
    }
    let m: int = math_max(10, 20);
    if (m != 20) {
        return 2;
    }
    let c: int = math_clamp(150, 0, 100);
    if (c != 100) {
        return 3;
    }
    let sq: double = math_sqrt(16.0);
    if (sq != 4.0) {
        return 4;
    }
    return 0;
}

#[bench]
fn bench_math() -> int {
    let x: int = 0;
    let i: int = 0;
    while (i < 1000) {
        x = x + math_abs(0 - 1);
        i = i + 1;
    }
    return 0;
}
