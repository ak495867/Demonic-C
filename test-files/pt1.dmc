struct Decl {
    kind: int;
    name: string;
    start: int;
    end: int;
}
fn skip_to_brace(ts: *Tok, count: int, open_idx: int) -> int {
    var depth: int = 0;
    var j: int = open_idx;
    while (j < count) {
        if (ts[j].kind == 4 && ts[j].text == "{") {
            depth = depth + 1;
        }
        if (ts[j].kind == 4 && ts[j].text == "}") {
            depth = depth - 1;
            if (depth == 0) {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}
fn find_brace(ts: *Tok, count: int, from: int) -> int {
    var j: int = from;
    while (j < count && !(ts[j].kind == 4 && ts[j].text == "{")) {
        j = j + 1;
    }
    return j;
}
fn main() -> int { return 0; }
