{
  "name": "demonic-c",
  "displayName": "Demonic C Language Support",
  "description": "Rich language support, syntax highlighting, and LSP integration for the Demonic C systems programming language.",
  "version": "1.4.0",
  "publisher": "ak495867",
  "engines": {
    "vscode": ">=1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "icon": "../../assets/logo.png",
  "contributes": {
    "languages": [
      {
        "id": "dmc",
        "aliases": ["Demonic C", "dmc"],
        "extensions": [".dmc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dmc",
        "scopeName": "source.dmc",
        "path": "./syntaxes/dmc.tmLanguage.json"
      }
    ]
  }
}
